# ================================================================
# AWS KUBERNETES PLATFORM
# EXAMPLE VARIABLES
# ================================================================

project_name = "aws-k8s-platform"
cluster_name = "k8s-cluster"

aws_region = "us-east-1"

# ----------------------------------------------------------------
# NETWORK
# ----------------------------------------------------------------

# existing = use an existing VPC
# managed  = Terraform creates a new VPC
network_mode = "existing"

# Existing VPC example
vpc_id = "vpc-xxxxxxxxxxxxxxxxx"

control_plane_subnet_id = "subnet-xxxxxxxxxxxxxxxxx"

worker_subnet_ids = [
  "subnet-xxxxxxxxxxxxxxxxx",
  "subnet-xxxxxxxxxxxxxxxxx",
  "subnet-xxxxxxxxxxxxxxxxx"
]

# ----------------------------------------------------------------
# KUBERNETES NETWORK
# ----------------------------------------------------------------

pod_cidr     = "10.244.0.0/16"
service_cidr = "10.96.0.0/12"

# ----------------------------------------------------------------
# EC2
# ----------------------------------------------------------------

# Ubuntu AMI appropriate for the selected AWS region.
ami_id = "ami-xxxxxxxxxxxxxxxxx"

control_plane_instance_type = "t3.medium"
worker_instance_type        = "t3.small"

# Existing EC2 key pair.
key_name = "your-key-pair"

root_volume_size = 30
root_volume_type = "gp3"

# ----------------------------------------------------------------
# WORKER AUTO SCALING GROUP
# ----------------------------------------------------------------

worker_min_size     = 1
worker_desired_size = 1
worker_max_size     = 5

# ----------------------------------------------------------------
# KUBERNETES VERSION
# ----------------------------------------------------------------

kubernetes_version       = "1.30.14"
kubernetes_minor_version = "1.30"

# ----------------------------------------------------------------
# SSM
# ----------------------------------------------------------------

ssm_join_parameter = "/k8s/join-command"

# ----------------------------------------------------------------
# SECURITY
# ----------------------------------------------------------------

# IMPORTANT:
# Replace this with your trusted public IP/CIDR before deployment.
#
# Example:
# admin_cidr = "203.0.113.25/32"
#
# Do NOT leave 0.0.0.0/0 for a production cluster.
admin_cidr = "0.0.0.0/0"

enable_ssh        = true
enable_public_api = true
enable_nodeport   = false
enable_http_https = false

# ----------------------------------------------------------------
# TAGS
# ----------------------------------------------------------------

additional_tags = {
  Environment = "platform"
  Owner       = "devops"
}
